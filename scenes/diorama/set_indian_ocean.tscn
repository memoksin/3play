	vec3 c = mix(base_color, alt_color, patch * 0.6);
	c = mix(c, wet_color, 1.0 - smoothstep(wet_level - 0.05, wet_level + 0.25, wpos.y));
	float rim = smoothstep(radius - fade, radius, length(wpos.xz));

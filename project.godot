config_version=5

[application]

config/name="3play"
run/main_scene="res://scenes/language.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.18039216, 0.13333334, 0.18431373, 1)

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[autoload]

Game="*res://scripts/game.gd"
Audio="*res://scripts/audio.gd"
Voice="*res://scripts/voice.gd"

[gui]

theme/custom="res://ui/theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.en.translation", "res://locale/strings.tr.translation")

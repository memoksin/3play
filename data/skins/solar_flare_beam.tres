; Beam minigame waves, ported 1:1 from the "Işın Ağı" prototype (#124). Rules: scripts/beam_logic.gd.
; Look: the 3D art (scenes/minigames/beam/sf/, assets/3d/solar_flare/); effects layer = the 2D placeholder fx.
[gd_resource type="Resource" script_class="BeamSkin" load_steps=18 format=3]

[ext_resource type="Script" path="res://scripts/beam_skin.gd" id="1"]
[ext_resource type="Script" path="res://scripts/beam_wave.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/minigames/beam/sf/board.tscn" id="board"]
[ext_resource type="PackedScene" path="res://scenes/minigames/beam/sf/backdrop.tscn" id="backdrop"]
[ext_resource type="PackedScene" path="res://scenes/minigames/beam/sf/grid.tscn" id="grid"]
